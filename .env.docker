# Used by containers in docker-compose: services reach each other by service name.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=proste_fakty

QDRANT_URL=http://qdrant:6333

CORS_ORIGINS=["http://localhost:5173"]

# The frontend runs in the browser on the host, so it still talks to the backend via localhost
VITE_API_URL=http://localhost:8000

# GEMINI_API_KEY is NOT set here (this file is committed); compose passes it from .env
GEMINI_MODEL=gemini-3.7-flash
