# Used when backend/frontend run locally (uv run / npm run dev) and connect
# to the postgres and qdrant containers through their published ports.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=proste_fakty

QDRANT_URL=http://localhost:6333

CORS_ORIGINS=["http://localhost:5173"]

VITE_API_URL=http://localhost:8000

# Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
